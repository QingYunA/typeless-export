{
  "name": "typeless-export",
  "version": "1.0.0",
  "description": "一键导出 Typeless 个人专有词库，支持迁移与导入到各种语音助手及输入法工具。",
  "type": "module",
  "bin": {
    "typeless-export": "./bin/cli.mjs",
    "tle": "./bin/cli.mjs"
  },
  "main": "./src/index.mjs",
  "scripts": {
    "export": "node ./bin/cli.mjs export",
    "import": "node ./bin/cli.mjs import",
    "sync": "node ./bin/cli.mjs sync",
    "migrate": "node ./bin/cli.mjs migrate"
  },
  "keywords": [
    "typeless",
    "typeless-export",
    "openless",
    "whisper",
    "voice-typing",
    "dictation",
    "vocabulary",
    "hotwords",
    "asr",
    "stt"
  ],
  "author": "Serein",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
